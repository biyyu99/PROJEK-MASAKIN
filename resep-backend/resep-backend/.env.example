# PORT (Vercel otomatis set ini, tidak perlu diisi manual)
# PORT=3000

# ── DATABASE ──────────────────────────────────────────────
# Pilihan A: Pakai DATABASE_URL dari Aiven (direkomendasikan untuk produksi)
DATABASE_URL=mysql://user:password@host:port/dbname?ssl-mode=REQUIRED

# Pilihan B: Pakai config terpisah (untuk development lokal)
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=recipe_app

# ── JWT ───────────────────────────────────────────────────
JWT_SECRET=ganti_dengan_string_acak_panjang_minimal_32_karakter
JWT_EXPIRES_IN=7d

# ── CLOUDINARY ────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── CORS ──────────────────────────────────────────────────
# Isi dengan URL frontend Vercel kamu (bisa lebih dari satu, pisahkan dengan koma)
ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:3001
